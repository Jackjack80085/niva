{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "start": "node scripts/dev.mjs --production",
    "test": "tsx --test server/*.test.ts src/utils/*.test.ts",
    "build:server": "esbuild server/index.ts server/edge.ts server/backup.ts server/vercel.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist-server",
    "backup": "tsx server/backup.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.10.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.4.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
