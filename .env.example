# Node 24 API. Local development uses the existing password until overridden.
APP_URL=http://localhost:3000
DATABASE_PATH=data/niva.sqlite
# REQUIRED for production, minimum 12 characters. Never use VITE_ for secrets.
ADMIN_PASSWORD=

# Optional until your provider accounts are ready.
RESEND_API_KEY=
MAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Connect later. Authorize the calendar owner with calendar.events and
# calendar.events.freebusy scopes and obtain a refresh token server-side.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Providers are OFF by default even if credentials are present.
ENABLE_PAYMENTS=false
ENABLE_CALENDAR=false
ENABLE_EMAIL=false

# Required in production: 32 random bytes represented by 64 hex characters.
# Supply through a secret manager, not source control. Losing it loses private records.
DATA_ENCRYPTION_KEY=
# Public entry point; the API always binds to loopback on API_PORT.
EDGE_PORT=3000
EDGE_HOST=127.0.0.1
API_PORT=3001
# GATEWAY_SECRET is generated privately by the launcher. Do not set a VITE_ variant.
