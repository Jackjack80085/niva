# Local Node 24 development; Vercel Production must use its real HTTPS origin.
APP_URL=http://localhost:3000
# Local SQLite only. Vercel uses DATABASE_URL (or POSTGRES_URL), never /tmp.
DATABASE_PATH=data/niva.sqlite
DATABASE_URL=
# POSTGRES_URL is also accepted if DATABASE_URL is unset.
# POSTGRES_URL=

# REQUIRED in production: unique password with at least 10 characters.
# Never use VITE_ for any server secret.
ADMIN_PASSWORD=
# REQUIRED in production and for remote Postgres: 32 random bytes as 64 hex chars.
# Keep this key separately from the database/backups; losing it loses records.
DATA_ENCRYPTION_KEY=
# Vercel: leave Node's request body untouched for Express to parse.
NODEJS_HELPERS=0
# Vercel: random secret authenticating the daily /api/cron/jobs request.
CRON_SECRET=
# Scope cloud database/admin/key secrets to Production. Previews need isolated envs.

# Providers stay OFF until intentionally connected and tested.
ENABLE_PAYMENTS=false
ENABLE_CALENDAR=false
ENABLE_EMAIL=false
RESEND_API_KEY=
MAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Connect later using the calendar owner's server-side OAuth refresh token.
# Required scopes: calendar.events and calendar.events.freebusy.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Local/persistent Node launcher only; Vercel Functions do not listen on ports.
EDGE_PORT=3000
EDGE_HOST=127.0.0.1
API_PORT=3001
# The launcher generates GATEWAY_SECRET privately; do not set a VITE_ variant.
